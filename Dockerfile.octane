# Laravel Octane (RoadRunner) runtime image — runs BESIDE the php-fpm image (Dockerfile).
# Same PHP version and extensions as production php-fpm so behaviour is identical.

# STAGE 1: PHP dependencies (includes laravel/octane + spiral/roadrunner-*)
FROM composer:2.7 AS vendor
WORKDIR /app
COPY composer.json composer.lock* ./
COPY database/ database/
RUN ok=0; for i in 1 2 3; do \
        composer install --no-dev --no-interaction --prefer-dist --optimize-autoloader \
            --ignore-platform-reqs --no-scripts && ok=1 && break \
        || { echo "composer attempt $i failed, retrying..."; sleep 15; }; \
    done; [ "$ok" = 1 ]

# STAGE 2: Frontend assets
FROM node:20-alpine AS assets
WORKDIR /app
COPY package*.json ./
RUN ok=0; for i in 1 2 3; do npm ci && ok=1 && break || { echo "npm attempt $i failed"; sleep 15; }; done; [ "$ok" = 1 ]
COPY . .
RUN npm run build

# STAGE 3: Extensions + RoadRunner binary
FROM php:8.3.36-cli-alpine AS builder
RUN apk add --no-cache icu-dev libzip-dev zip unzip autoconf g++ gcc libc-dev make linux-headers \
    && docker-php-ext-install -j$(nproc) pdo_mysql opcache zip pcntl intl sockets \
    && pecl install redis && docker-php-ext-enable redis
COPY --from=vendor /app/vendor /vendor
# composer 'files' autoload expects /app/Helpers relative to /vendor when rr boots the autoloader
COPY app/Helpers /app/Helpers
# rr get-binary picks the RoadRunner build that matches the installed Octane/roadrunner-cli.
RUN cd / && mkdir -p /rr && cd /rr && php /vendor/bin/rr get-binary --location /rr --no-interaction

# STAGE 4: Runtime
FROM php:8.3.36-cli-alpine
WORKDIR /var/www/html
RUN apk add --no-cache icu-libs libzip zip unzip
COPY --from=builder /usr/local/lib/php/extensions /usr/local/lib/php/extensions
COPY --from=builder /usr/local/etc/php/conf.d /usr/local/etc/php/conf.d
COPY --from=builder /rr/rr /usr/local/bin/rr

# Same OPcache/JIT policy as php-fpm. Long-lived workers keep opcache hot.
RUN printf "opcache.enable=1\nopcache.enable_cli=1\nopcache.jit_buffer_size=100M\nopcache.jit=tracing\nopcache.memory_consumption=256\nopcache.max_accelerated_files=20000\nopcache.validate_timestamps=0\nopcache.interned_strings_buffer=16\n" \
    > /usr/local/etc/php/conf.d/docker-php-ext-opcache.ini

COPY --chown=www-data:www-data . .
COPY --from=vendor --chown=www-data:www-data /app/vendor/ vendor/
COPY --from=assets --chown=www-data:www-data /app/public/build public/build
COPY --from=assets --chown=www-data:www-data /app/public/build /var/www/build_cache
# PHP hardening from the validated local image (memory_limit 512M, strict sessions, no display_errors, upload limits).
COPY docker/php/security.ini /usr/local/etc/php/conf.d/security.ini
# RoadRunner workers are long-lived CLI processes; ini max_execution_time counts accumulated CPU time there and would kill
# healthy workers. The per-request cap is rr http.pool.supervisor.exec_ttl (300s) in .rr.prod.yaml.
RUN printf "max_execution_time=0\n" > /usr/local/etc/php/conf.d/zz-rr-worker.ini
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

USER www-data
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
# RoadRunner-only runtime (user-validated isolating worker app/Octane/roadrunner_worker.php) with production tuning.
CMD ["rr", "serve", "-c", ".rr.prod.yaml"]
