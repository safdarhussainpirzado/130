[mysqld]
# ==============================================================================
# NATIONAL HIGHWAYS & MOTORWAY POLICE (NHMP) 130 HELPLINE
# MySQL Configuration: PRODUCTION HIGH-AVAILABILITY CLUSTER
# Memory Footprint: ~7.5GB RSS (Buffer Pool: 6GB)
# Purpose: Mission-critical 24/7 emergency response, 5000 concurrent patrols
# ==============================================================================

user                            = mysql
pid-file                        = /var/run/mysqld/mysqld.pid
socket                          = /var/run/mysqld/mysqld.sock
port                            = 3306
datadir                         = /var/lib/mysql

# Buffer Pool & Durability (6GB Pool, 4 Instances)
innodb_buffer_pool_size         = 6G
innodb_buffer_pool_instances     = 4
innodb_redo_log_capacity        = 1G
innodb_log_buffer_size          = 64M
innodb_flush_log_at_trx_commit  = 1
innodb_file_per_table           = 1
innodb_stats_on_metadata        = 0

# InnoDB Enterprise NVMe/SSD I/O Settings
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 4000
innodb_io_capacity_max          = 8000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_max_dirty_pages_pct      = 70
innodb_max_dirty_pages_pct_lwm  = 50
innodb_flush_neighbors          = 0
innodb_idle_flush_pct           = 50

# Temporary Tables and Query Buffers
tmp_table_size                  = 64M
max_heap_table_size             = 64M
join_buffer_size                = 4M
sort_buffer_size                = 4M

# Connection Sizing for Call Center Concurrency
max_connections                 = 350
max_allowed_packet              = 64M
thread_cache_size               = 32
wait_timeout                    = 600
interactive_timeout             = 600

# High-Availability Replication & Binary Log Integrity
sync_binlog                     = 1
log_bin_trust_function_creators = 1
slow_query_log                  = 1
slow_query_log_file             = /var/lib/mysql/mysql-slow.log
long_query_time                 = 1
log_queries_not_using_indexes   = 0

# Strict Multi-Lingual Character Sets
character-set-server            = utf8mb4
collation-server                 = utf8mb4_unicode_ci

[client]
default-character-set           = utf8mb4
