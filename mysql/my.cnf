[mysqld]
# Basic settings
user            = mysql
pid-file        = /var/run/mysqld/mysqld.pid
socket          = /var/run/mysqld/mysqld.sock
port            = 3306
datadir         = /var/lib/mysql

# Optimized Performance Settings
# Sized from measurement (2026-11-10): whole 130_crm_db is ~770 MB, hit ratio 99.9999%.
# 1.5 GB gives ~2x headroom for growth; 8 GB would only waste RAM (3 MySQL containers share the host).
innodb_buffer_pool_size         = 3072M
# innodb_log_file_size is deprecated in 8.4, use redo log capacity instead
innodb_redo_log_capacity        = 256M
innodb_log_buffer_size          = 16M
# Full durability: fsync ~1.5 ms on this disk, ~0.1 commits/s average => negligible cost.
innodb_flush_log_at_trx_commit  = 1
innodb_file_per_table           = 1
innodb_stats_on_metadata        = 0

# Connection settings
max_connections                 = 150
max_allowed_packet              = 64M
thread_cache_size               = 64

# Logging & Binary Log
sync_binlog                     = 1
# Sort_merge_passes was 1.86M with the 256K default; 2M removes on-disk merge sorts (per-session, allocated on demand).
sort_buffer_size                = 2M
log_bin_trust_function_creators = 1
slow_query_log                  = 1
slow_query_log_file             = /var/lib/mysql/mysql-slow.log
long_query_time                 = 2

# Character Sets
character-set-server            = utf8mb4
collation-server                 = utf8mb4_unicode_ci

# Disable Performance Schema if memory is tight
# performance_schema             = OFF

[client]
default-character-set           = utf8mb4
