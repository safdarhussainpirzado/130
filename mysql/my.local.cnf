[mysqld]
# ==============================================================================
# NHMP 130 — MySQL Configuration: LOCAL DEVELOPMENT SANDBOX
# Memory Footprint: ~150MB RSS (Buffer Pool: 128MB)
# Purpose: Minimal RAM footprint for local workstations & WSL2
# ==============================================================================

user                            = mysql
pid-file                        = /var/run/mysqld/mysqld.pid
socket                          = /var/run/mysqld/mysqld.sock
port                            = 3306
datadir                         = /var/lib/mysql

# Buffer Pool & Redo Log (Ultra-Low Memory)
innodb_buffer_pool_size         = 128M
innodb_buffer_pool_instances     = 1
innodb_redo_log_capacity        = 32M
innodb_log_buffer_size          = 4M
innodb_flush_log_at_trx_commit  = 2
innodb_file_per_table           = 1
innodb_stats_on_metadata        = 0

# InnoDB I/O Settings
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 200
innodb_io_capacity_max          = 400
innodb_read_io_threads          = 2
innodb_write_io_threads         = 2
innodb_max_dirty_pages_pct      = 70
innodb_max_dirty_pages_pct_lwm  = 50
innodb_flush_neighbors          = 0
innodb_idle_flush_pct           = 50

# Temporary Tables and Memory Buffers
tmp_table_size                  = 16M
max_heap_table_size             = 16M
join_buffer_size                = 512K
sort_buffer_size                = 512K

# Connection Settings
max_connections                 = 150
max_allowed_packet              = 32M
thread_cache_size               = 8
wait_timeout                    = 300
interactive_timeout             = 300

# Logging & Replication
sync_binlog                     = 1
log_bin_trust_function_creators = 1
slow_query_log                  = 1
slow_query_log_file             = /var/lib/mysql/mysql-slow.log
long_query_time                 = 1
log_queries_not_using_indexes   = 0

# Character Sets
character-set-server            = utf8mb4
collation-server                 = utf8mb4_unicode_ci

[client]
default-character-set           = utf8mb4
