[mysqld]
# Basic settings
user            = mysql
pid-file        = /var/run/mysqld/mysqld.pid
socket          = /var/run/mysqld/mysqld.sock
port            = 3306
datadir         = /var/lib/mysql

# Production 16-Core / 31 GB Host Profile (6 GB Buffer Pool Base, scalable to 8 GB)
innodb_buffer_pool_size         = 6G
innodb_buffer_pool_instances     = 6
innodb_redo_log_capacity        = 1536M
innodb_log_buffer_size          = 64M
innodb_flush_log_at_trx_commit  = 1
innodb_file_per_table           = 1
innodb_stats_on_metadata        = 0

# InnoDB I/O and Checkpoint Optimization (NVMe / High IOPS SSD)
innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 4000
innodb_io_capacity_max          = 8000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8
innodb_max_dirty_pages_pct      = 75
innodb_max_dirty_pages_pct_lwm  = 50
innodb_flush_neighbors          = 0
innodb_idle_flush_pct           = 50
innodb_adaptive_flushing        = ON
innodb_change_buffering         = all

# Memory and Temp Tables
tmp_table_size                  = 128M
max_heap_table_size             = 128M
join_buffer_size                = 8M
sort_buffer_size                = 8M

# Connection and Thread Pool settings
max_connections                 = 300
max_allowed_packet              = 64M
thread_cache_size               = 64
wait_timeout                    = 300
interactive_timeout             = 300

# Strict Binary Logging & Durability for Emergency Call Intake
sync_binlog                     = 1
log_bin_trust_function_creators = 1
binlog_format                   = ROW
binlog_row_image                = MINIMAL
gtid_mode                       = ON
enforce_gtid_consistency        = ON
log_replica_updates             = ON

# Slow Query Diagnostics
slow_query_log                  = 1
slow_query_log_file             = /var/lib/mysql/mysql-slow.log
long_query_time                 = 0.5
log_queries_not_using_indexes   = 0

# Character Sets
character-set-server            = utf8mb4
collation-server                 = utf8mb4_unicode_ci

[client]
default-character-set           = utf8mb4
