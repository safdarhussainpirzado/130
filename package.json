{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "test": "bash scripts/test/run_fast.sh",
        "test:fast": "bash scripts/test/run_fast.sh",
        "test:browser": "bash scripts/test/run_browser.sh",
        "test:browser:smoke": "npx playwright test tests/Browser/auth.spec.ts tests/Browser/dashboard.spec.ts",
        "test:browser:full": "npx playwright test",
        "test:browser:uat": "npx playwright test tests/Browser/calls.spec.ts tests/Browser/reports.spec.ts",
        "test:browser:data-integrity": "npx playwright test tests/Browser/calls.spec.ts",
        "test:security": "bash scripts/test/run_security.sh",
        "test:staging:full": "bash scripts/test/run_release.sh",
        "test:release": "bash scripts/test/run_release.sh"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "@types/node": "^26.6.6",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "axios": "^1.11.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^2.0.0",
        "postcss": "^8.4.31",
        "tailwindcss": "^3.1.0",
        "vite": "^7.0.7"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.11",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "chart.js": "^4.5.1",
